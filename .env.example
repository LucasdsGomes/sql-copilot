# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# SQLite file the agent queries (opened read-only by the app)
DATABASE_PATH=data/sales.db

# API protection: comma-separated keys accepted by the API (header X-API-Key).
# Left empty on purpose: the API rejects every request until you set your own.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
API_KEYS=
RATE_LIMIT=10/minute

# Hard cap on rows returned by any generated query
MAX_ROWS=100
